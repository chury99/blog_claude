# 비밀값
.env

# 생성된 글 (발행 기록 포함 — 로컬에만 보관)
posts/*
!posts/.gitkeep

# 파이프라인 상태 (기수록 공시 등)
data/*
!data/.gitkeep

# launchd 실행 로그
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# macOS
.DS_Store

# Claude Code 로컬 설정 (머신별)
.claude/settings.local.json

# 텔레그램 자격증명 (예시 파일만 커밋)
config/*.json
!config/*.json.example
