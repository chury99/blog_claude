# cp .env.example .env 후 실제 값 입력. .env 는 git 제외됨.

# Ghost Admin API 키. Ghost 관리자 > Settings > Integrations > Add custom integration
# 형식: <id>:<secret>
GHOST_ADMIN_API_KEY=

# 파일로 두는 비밀값 (환경변수 아님):
#   DART 인증키       → config/dart.json      (python 실행 시 export 불필요)
#   텔레그램 토큰/채팅  → config/telegram.json  (python pipeline.py telegram setup)
