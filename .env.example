# cp .env.example .env 후 실제 값 입력. .env 는 git 제외됨.

# Ghost Admin API 키. Ghost 관리자 > Settings > Integrations > Add custom integration
# 형식: <id>:<secret>
GHOST_ADMIN_API_KEY=

# 텔레그램 자격증명은 여기가 아니라 config/telegram.json 에 둔다.
#   python pipeline.py telegram setup --token <BotFather 토큰>

# Reddit (collect.sources.reddit.enabled=true 인 경우에만 필요)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=content-pipeline/0.1 by u/yourname
